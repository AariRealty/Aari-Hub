# Copy this file to .env.local and fill in the values from your Supabase project.
# Settings → API: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of email addresses allowed to sign in to /admin.
# Anyone whose email isn't in this list will be rejected at the middleware.
ADMIN_EMAILS=you@example.com

# Used by the email-on-new-lead notifier (Resend). If any of these are missing
# the notification is skipped silently — the lead is still saved.
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
# Where new-lead alerts should arrive (probably your inbox)
NOTIFICATION_EMAIL=you@example.com
# The From: address. Must be on a verified domain in Resend, OR use
# "onboarding@resend.dev" for testing without verifying anything.
NOTIFICATION_FROM_EMAIL=Aari Hub <onboarding@resend.dev>

# Public site URL (no trailing slash). Used to render an "Open in CRM" link
# in the new-lead email. Set to your localhost during dev or your real
# domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
